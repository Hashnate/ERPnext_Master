 "font": "Default",
 "font_size": 12,
 "html": "<style>\n\t.sl-slip { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1a1a1a; page-break-after: always; }\n\t.sl-slip:last-child { page-break-after: auto; }\n\t.sl-slip-hdr { display: flex; justify-content: space-between; border-bottom: 2px solid #1a1a1a; padding-bottom: 8px; margin-bottom: 12px; }\n\t.sl-slip-title { font-size: 18px; font-weight: 700; text-transform: uppercase; }\n\t.sl-meta { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n\t.sl-meta td { padding: 4px 8px; border: 1px solid #d0d0d0; font-size: 11px; }\n\t.sl-grid { display: flex; gap: 14px; margin-bottom: 12px; }\n\t.sl-col { flex: 1; }\n\t.sl-tbl { width: 100%; border-collapse: collapse; }\n\t.sl-tbl th { background: #f3f4f6; border: 1px solid #ccc; padding: 6px; font-size: 11px; text-align: left; }\n\t.sl-tbl td { border: 1px solid #ccc; padding: 6px; font-size: 11px; }\n\t.text-right { text-align: right; }\n\t.sl-net { border: 2px solid #1a1a1a; padding: 8px 12px; background: #f3f4f6; display: flex; justify-content: space-between; font-size: 14px; font-weight: 700; margin-bottom: 10px; }\n\t.sl-stat { font-size: 11px; color: #444; border: 1px solid #d0d0d0; padding: 8px 10px; border-radius: 4px; }\n</style>\n{% for row in doc.employees %}\n<div class=\"sl-slip\">\n\t<div class=\"sl-slip-hdr\">\n\t\t<div>\n\t\t\t<div style=\"font-size: 16px; font-weight: 700;\">{{ doc.company }}</div>\n\t\t\t<div>Payroll Run: {{ doc.name }}</div>\n\t\t</div>\n\t\t<div class=\"text-right\">\n\t\t\t<div class=\"sl-slip-title\">PAYSLIP</div>\n\t\t\t<div>Period: {{ doc.get_formatted('from_date') }} to {{ doc.get_formatted('to_date') }}</div>\n\t\t\t<div>Pay Date: {{ doc.get_formatted('posting_date') }}</div>\n\t\t</div>\n\t</div>\n\t<table class=\"sl-meta\">\n\t\t<tr>\n\t\t\t<td><strong>Employee ID:</strong> {{ row.employee }}</td>\n\t\t\t<td><strong>Employee Name:</strong> {{ row.employee_name }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>NIC No.:</strong> {{ row.nic_number or 'N/A' }}</td>\n\t\t\t<td><strong>EPF Member No.:</strong> {{ row.epf_number or 'N/A' }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>Bank:</strong> {{ row.bank_name or 'N/A' }} ({{ row.bank_code or '-' }} / {{ row.branch_code or '-' }})</td>\n\t\t\t<td><strong>Account No.:</strong> {{ row.bank_account_no or 'N/A' }}</td>\n\t\t</tr>\n\t</table>\n\t<div class=\"sl-grid\">\n\t\t<div class=\"sl-col\">\n\t\t\t<table class=\"sl-tbl\">\n\t\t\t\t<thead><tr><th>Earnings</th><th class=\"text-right\">Amount ({{ doc.currency }})</th></tr></thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr><td>Basic Salary</td><td class=\"text-right\">{{ row.get_formatted('basic_salary') }}</td></tr>\n\t\t\t\t\t<tr><td>EPF-Liable Allowances / BRA</td><td class=\"text-right\">{{ row.get_formatted('epf_liable_allowances') }}</td></tr>\n\t\t\t\t\t<tr><td>Non-EPF Allowances</td><td class=\"text-right\">{{ row.get_formatted('non_epf_allowances') }}</td></tr>\n\t\t\t\t\t<tr><td>Lump Sum / Bonus</td><td class=\"text-right\">{{ row.get_formatted('lump_sum_bonus') }}</td></tr>\n\t\t\t\t\t<tr><th>Gross Pay</th><th class=\"text-right\">{{ row.get_formatted('gross_pay') }}</th></tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t</div>\n\t\t<div class=\"sl-col\">\n\t\t\t<table class=\"sl-tbl\">\n\t\t\t\t<thead><tr><th>Deductions</th><th class=\"text-right\">Amount ({{ doc.currency }})</th></tr></thead>\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr><td>EPF Employee Contribution</td><td class=\"text-right\">{{ row.get_formatted('epf_employee') }}</td></tr>\n\t\t\t\t\t<tr><td>APIT / PAYE Tax</td><td class=\"text-right\">{{ row.get_formatted('apit_tax') }}</td></tr>\n\t\t\t\t\t<tr><td>Other Deductions</td><td class=\"text-right\">{{ row.get_formatted('other_deductions') }}</td></tr>\n\t\t\t\t\t<tr><th>Total Deductions</th><th class=\"text-right\">{{ row.get_formatted('total_deduction') }}</th></tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t</div>\n\t</div>\n\t<div class=\"sl-net\">\n\t\t<span>NET PAY ({{ doc.currency }})</span>\n\t\t<span>{{ row.get_formatted('net_pay') }}</span>\n\t</div>\n\t<div class=\"sl-stat\">\n\t\t<strong>Employer Statutory Contributions (Not Deducted from Pay):</strong>\n\t\tEPF Liable Base: {{ row.get_formatted('epf_liable_earnings') }} |\n\t\tEPF Employer (12%): {{ row.get_formatted('epf_employer') }} |\n\t\tETF Employer (3%): {{ row.get_formatted('etf_employer') }}\n\t</div>\n</div>\n{% endfor %}",
