 "html": "<style>\n\t.sl-simp-wrap { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1a1a1a; }\n\t.sl-simp-head { text-align: center; border-bottom: 1px dashed #333; padding-bottom: 8px; margin-bottom: 10px; }\n\t.sl-simp-title { font-size: 16px; font-weight: 700; text-transform: uppercase; margin-top: 4px; }\n\t.sl-simp-table { width: 100%; border-collapse: collapse; margin: 10px 0; }\n\t.sl-simp-table th, .sl-simp-table td { border-bottom: 1px solid #ddd; padding: 5px 4px; font-size: 11px; }\n\t.text-right { text-align: right; }\n</style>\n<div class=\"sl-simp-wrap\">\n\t<div class=\"sl-simp-head\">\n\t\t<div style=\"font-size: 15px; font-weight: 700;\">{{ doc.company }}</div>\n\t\t<div>{{ doc.company_address_display or '' }}</div>\n\t\t<div><strong>VAT Reg. No.:</strong> {{ doc.company_vat_reg_no or frappe.db.get_value('Company', doc.company, 'tax_id') or 'N/A' }}</div>\n\t\t<div class=\"sl-simp-title\">SIMPLIFIED TAX INVOICE</div>\n\t</div>\n\t<div style=\"display: flex; justify-content: space-between; margin-bottom: 8px;\">\n\t\t<div><strong>Customer:</strong> {{ doc.customer_name }}</div>\n\t\t<div class=\"text-right\"><strong>Invoice:</strong> {{ doc.name }} | <strong>Date:</strong> {{ doc.get_formatted('posting_date') }}</div>\n\t</div>\n\t<table class=\"sl-simp-table\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th>Item</th>\n\t\t\t\t<th class=\"text-right\">Qty</th>\n\t\t\t\t<th class=\"text-right\">Rate</th>\n\t\t\t\t<th class=\"text-right\">Amount ({{ doc.currency }})</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for item in doc.items %}\n\t\t\t<tr>\n\t\t\t\t<td>{{ item.item_name }}</td>\n\t\t\t\t<td class=\"text-right\">{{ item.get_formatted('qty') }}</td>\n\t\t\t\t<td class=\"text-right\">{{ item.get_formatted('rate') }}</td>\n\t\t\t\t<td class=\"text-right\">{{ item.get_formatted('amount') }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\t<div class=\"text-right\" style=\"margin-top: 8px;\">\n\t\t<div><strong>Total Excl. VAT:</strong> {{ doc.get_formatted('net_total') }}</div>\n\t\t<div><strong>Total VAT:</strong> {{ doc.get_formatted('total_taxes_and_charges') }}</div>\n\t\t<div style=\"font-size: 14px; font-weight: 700; margin-top: 4px;\">Grand Total: {{ doc.get_formatted('grand_total') }}</div>\n\t</div>\n\t{% if doc.in_words %}<div style=\"margin-top: 8px;\"><strong>In Words:</strong> {{ doc.in_words }}</div>{% endif %}\n</div>",
